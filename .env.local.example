# Environment Variables for Local Development
# Copy this file to .env.local and update the values for your local setup

# =============================================================================
# PokeAPI Configuration
# =============================================================================

# Local Self-Hosted PokeAPI Instance
# Use these for local builds with your self-hosted PokeAPI to avoid rate limiting
NEXT_PUBLIC_POKEAPI_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_POKEAPI_REST_URL=http://localhost/api/v2

# Production Public PokeAPI (used if env vars not set)
# These are the defaults - uncomment to explicitly use public API
# NEXT_PUBLIC_POKEAPI_GRAPHQL_URL=https://graphql.pokeapi.co/v1beta2
# NEXT_PUBLIC_POKEAPI_REST_URL=https://pokeapi.co/api/v2

# =============================================================================
# Cloudflare Turnstile (for bot protection)
# =============================================================================

# Get your keys from: https://dash.cloudflare.com/
TURNSTILE_SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here

# =============================================================================
# Build Instructions
# =============================================================================

# To build with local PokeAPI:
# 1. Start your self-hosted PokeAPI instance
# 2. Copy this file to .env.local: cp .env.local.example .env.local
# 3. Update the URLs above if your ports differ
# 4. Run: npm run build

# To build with public PokeAPI:
# 1. Delete or rename .env.local
# 2. Or comment out the NEXT_PUBLIC_POKEAPI_* variables above
# 3. Run: npm run build
